{
  "name": "jewelry-erp",
  "private": true,
  "version": "0.4.0",
  "description": "Jewelry ERP — orchestrator scripts. Backend lives in ./backend, frontend in ./frontend.",
  "scripts": {
    "//-- everyday --": "",
    "dev": "concurrently -k -n db,api,ui -c blue,green,magenta \"npm:_dev:db\" \"npm:_dev:api\" \"npm:_dev:ui\"",
    "stop": "docker compose down",
    "_dev:db": "docker compose up postgres",
    "_dev:api": "node scripts/python.js -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
    "_dev:ui": "npm --prefix frontend run dev",

    "//-- one-time setup --": "",
    "init": "npm run setup && npm run db:up && npm run migrate && npm run seed",
    "setup": "npm run setup:env && npm run setup:backend && npm run setup:frontend",
    "setup:env": "node scripts/copy-env.js",
    "setup:backend": "cd backend && python -m venv .venv && node ../scripts/python.js -m pip install --upgrade pip && node ../scripts/python.js -m pip install -r requirements.txt",
    "setup:frontend": "npm --prefix frontend install",

    "//-- database --": "",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:fresh": "node scripts/python.js -m tools.db_fresh && npm run migrate && npm run seed",
    "db:reset": "npm run db:fresh",
    "db:psql": "node scripts/python.js -m tools.db_psql",

    "//-- backend tasks --": "",
    "migrate": "node scripts/python.js -m alembic upgrade head",
    "check:schema": "node scripts/python.js -m tools.check_schema_drift",
    "check:images": "node scripts/python.js -m tools.check_images",
    "seed": "node scripts/python.js -m app.seed",
    "test": "node scripts/python.js -m tests.e2e",
    "test:smoke": "npm run test:smoke:twoperson && npm run test:smoke:branches && npm run test:smoke:orders && npm run test:smoke:risk && npm run test:smoke:notify && npm run test:smoke:approvals && npm run test:smoke:goldbuy && npm run test:smoke:partymetal && npm run test:smoke:trade",
    "test:smoke:twoperson": "node scripts/python.js -m tests.smoke_two_person",
    "test:smoke:branches": "node scripts/python.js -m tests.smoke_branches",
    "test:smoke:orders": "node scripts/python.js -m tests.smoke_orders",
    "test:smoke:risk": "node scripts/python.js -m tests.smoke_karigar_risk",
    "test:smoke:notify": "node scripts/python.js -m tests.smoke_notifications",
    "test:smoke:approvals": "node scripts/python.js -m tests.smoke_approvals",
    "test:smoke:goldbuy": "node scripts/python.js -m tests.smoke_gold_purchase",
    "test:smoke:partymetal": "node scripts/python.js -m tests.smoke_party_metal",
    "test:smoke:trade": "node scripts/python.js -m tests.smoke_trade_billing",

    "//-- build / production --": "",
    "build": "npm --prefix frontend run build",
    "typecheck": "npm --prefix frontend run build -- --mode production",
    "prod:up": "docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build",
    "prod:down": "docker compose -f docker-compose.prod.yml down",
    "prod:logs": "docker compose -f docker-compose.prod.yml logs -f"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
