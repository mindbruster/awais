# Copy to .env.prod and fill the secrets below before running:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# Deploying to Railway instead? These are the same variables, but you set them
# as service variables in the Railway dashboard rather than in a file — Railway
# never reads this. Follow docs/DEPLOYMENT.md; it says which service each one
# belongs to and which of them are BUILD-time.
#
# The app refuses to start outside development/test/ci while any of JWT_SECRET,
# SEED_ADMIN_PASSWORD or DEBUG are still on their shipped values — so every
# `change-me` below has to be replaced, not just the ones you remember.

# --- Environment ---
# Anything other than development/test/ci enables the startup secret checks.
ENVIRONMENT=production
DEBUG=false

# --- Postgres ---
POSTGRES_USER=jewelry
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=jewelry_erp

# On Railway you do not set these. Attach the Postgres plugin and reference its
# connection string on the backend service:
#   DATABASE_URL = ${{Postgres.DATABASE_URL}}
# The plugin hands out a postgresql:// URL; app/core/config.py rewrites it to
# postgresql+asyncpg:// on load, because the async engine cannot use the bare
# driver name. Do not "fix" the value by hand.

# --- Backend ---
# Must be at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Comma-separated list of allowed origins — the EXACT public origin(s) of the
# frontend, scheme included, no trailing slash. "example.com" or
# "https://example.com/" will not match and the browser will block every API
# call with a CORS error while the API itself looks perfectly healthy.
CORS_ORIGINS=http://localhost

# Seed admin (created on first startup; ignored if the user already exists).
# Leaving this as the development default (admin123) blocks startup.
SEED_ADMIN_EMAIL=admin@jewelryerp.com
SEED_ADMIN_PASSWORD=change-me-on-first-login
SEED_ADMIN_NAME="System Admin"

# --- File storage (product photographs) ---
# local = write to UPLOAD_DIR on disk. Correct for development and for a single
#         host with a real volume (docker-compose.prod.yml mounts one).
# s3    = any S3-compatible bucket. REQUIRED on Railway, Render, Fly and every
#         other platform with an ephemeral container filesystem, where "local"
#         silently deletes every photograph on each redeploy.
STORAGE_BACKEND=local

# Only read when STORAGE_BACKEND=s3. Values below are for Cloudflare R2; AWS S3,
# Backblaze B2, MinIO and Spaces work the same way with their own endpoints.
# See docs/DEPLOYMENT.md for creating the bucket and the API token.
#
# The private endpoint used WITH credentials to write objects.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=jewelry-erp-uploads
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
# The PUBLIC read address of the same bucket — a different host from S3_ENDPOINT.
# Either the r2.dev development URL or a custom domain in front of the bucket.
# This string is stored in product.image_url, so changing it later orphans the
# URLs already in the database.
S3_PUBLIC_BASE_URL=https://images.<your-domain>
# Optional. R2 ignores the region; AWS S3 needs the real one (e.g. eu-west-1).
S3_REGION=auto
# Optional. Key prefix inside the bucket, so uploads share a bucket cleanly.
S3_PREFIX=products

# Only used when STORAGE_BACKEND=local.
UPLOAD_DIR=/app/uploads

# --- AI (optional; see docs/AI_SETUP.md) ---
# Nothing here is load-bearing: with AI_PROVIDER=none every report still returns
# its figures and only the written explanation is omitted.
# openrouter needs no extra package; anthropic needs `pip install anthropic`.
AI_PROVIDER=none
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Defaults follow the provider: z-ai/glm-4.7-flash for openrouter (about
# $0.06/M input — note that NO GLM model is on OpenRouter's free tier),
# claude-opus-5 for anthropic. Use openai/gpt-oss-20b:free for zero cost.
AI_MODEL=
# Cosmetic; only affects attribution in the OpenRouter dashboard.
AI_APP_URL=
AI_APP_NAME=Jewelry ERP

# --- WhatsApp (optional) ---
WHATSAPP_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- Frontend ---
FRONTEND_PORT=80

# BUILD-time, not runtime. Vite inlines this into the JavaScript bundle, so it
# is passed as a Docker build arg and changing it requires a REBUILD, never a
# restart. On Railway set it as a variable on the frontend service (Railway
# forwards service variables to the Docker build) and redeploy.
#   single host / compose : /api/v1
#   split domains         : https://api.<your-domain>/api/v1
VITE_API_BASE_URL=/api/v1
