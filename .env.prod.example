# Copy to .env.prod and fill the secrets below before running:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# The app refuses to start outside development/test/ci while any of JWT_SECRET,
# SEED_ADMIN_PASSWORD or DEBUG are still on their shipped values — so every
# `change-me` below has to be replaced, not just the ones you remember.

# --- Environment ---
# Anything other than development/test/ci enables the startup secret checks.
ENVIRONMENT=production
DEBUG=false

# --- Postgres ---
POSTGRES_USER=jewelry
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=jewelry_erp

# --- Backend ---
# Must be at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Comma-separated list of allowed origins (the public URL of the frontend).
CORS_ORIGINS=http://localhost

# Seed admin (created on first startup; ignored if the user already exists).
# Leaving this as the development default (admin123) blocks startup.
SEED_ADMIN_EMAIL=admin@jewelryerp.com
SEED_ADMIN_PASSWORD=change-me-on-first-login
SEED_ADMIN_NAME="System Admin"

# --- Frontend ---
FRONTEND_PORT=80

# --- WhatsApp (optional) ---
WHATSAPP_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
