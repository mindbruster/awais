yarn-error.log*

# Env / secrets
.env
.env.local
.env.*.local
backend/.env
frontend/.env
# Holds real production secrets — .env.prod.example is the template that is
# meant to be committed, this is the filled-in copy that never should be.
.env.prod
.env.production

# IDE
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Database / uploads
*.sqlite3
*.db
backend/uploads/
backend/media/

# Docker volumes (if mounted locally)
postgres_data/
pgadmin_data/

# Claude Code local settings
# Claude Code's local working area. `.claude/worktrees/` holds full git
# worktrees — committing one would check in a second copy of the whole repo.
.claude/
