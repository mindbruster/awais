# --- App ---
APP_NAME="Jewelry ERP"
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DEBUG=true

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
DATABASE_URL=postgresql+asyncpg://jewelry:jewelry_dev_password@localhost:5432/jewelry_erp

# --- JWT ---
# Generate a strong secret in production: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-please-use-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Seed admin (used by `python -m app.seed`) ---
SEED_ADMIN_EMAIL=admin@jewelryerp.com
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME="System Admin"

# --- WhatsApp (Phase 9, optional) ---
# Set provider=twilio + the three values below to actually send.
WHATSAPP_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- AI (optional; see docs/AI_SETUP.md) ---
# Nothing here is load-bearing: with AI_PROVIDER=none every report still returns
# its figures and only the written explanation is omitted.
# openrouter needs no extra package; anthropic needs `pip install anthropic`.
AI_PROVIDER=none
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Defaults follow the provider: z-ai/glm-4.7-flash for openrouter (about
# $0.06/M input — note that NO GLM model is on OpenRouter's free tier),
# claude-opus-5 for anthropic. Use openai/gpt-oss-20b:free for zero cost.
AI_MODEL=
# Drawing pieces. OpenRouter only — no Anthropic model draws. Costs cents per
# call, so nothing generates one without somebody pressing the button. Leave
# unset to use the default (google/gemini-2.5-flash-image-preview).
AI_IMAGE_MODEL=
# Cosmetic; only affects attribution in the OpenRouter dashboard.
AI_APP_URL=
AI_APP_NAME=Jewelry ERP

# Live metal rates (optional) — goldpricez.com. Without a key the Live rates
# tab says so rather than failing. This feed is display-only: the rate you set
# under Gold rates is what prices invoices, costing and every journal entry.
GOLDPRICEZ_API_KEY=

# Four eyes on a metal write-off: the person who submitted a stock count may not
# be the one who posts it. Off by default — a shop with a single admin would
# otherwise be unable to post a count at all, which pushes the reconciliation
# back onto paper. Turn it on once two people can sign in.
REQUIRE_TWO_PERSON_APPROVAL=false

# The tier above admin: feature flags and role permissions. Its own account
# rather than a hat the admin wears, because the point of the tier is that the
# person running the counter is not the person deciding what everybody may
# reach — one shared login collapses them back together.
#
# Change this before anyone else can reach the machine. It is the account that
# can switch modules off and rewrite what every role may do.
SEED_SUPERADMIN_EMAIL=superadmin@jewelryerp.com
SEED_SUPERADMIN_PASSWORD=superadmin123
SEED_SUPERADMIN_NAME=Super Admin
